rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Khata cloud data is private to its owning Firebase account.
    // Sharing snapshots will use a separate, narrowly-scoped rule surface
    // in the sharing phase; do not broaden these rules for viewers here.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }
  }
}
